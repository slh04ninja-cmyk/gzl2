# ============================================================
#  .env — Paramètres fixes du Trading Bot
#  Fichier à mettre dans la racine du repo GitHub
#  Les paramètres secrets (MT5, Telegram auth) sont injectés
#  automatiquement par le workflow à chaque run.
# ============================================================

# ── Canaux Telegram signaux (1 à 10) ─────────────────────────
TG_CHANNEL_1=@Canal1
TG_CHANNEL_2=
TG_CHANNEL_3=
TG_CHANNEL_4=
TG_CHANNEL_5=
TG_CHANNEL_6=
TG_CHANNEL_7=
TG_CHANNEL_8=
TG_CHANNEL_9=
TG_CHANNEL_10=

# ── Canal de rapport ─────────────────────────────────────────
TG_REPORT_CHANNEL=

# ── Trading ──────────────────────────────────────────────────
LOT_TOTAL=0.01
TRAIL_POINTS=150
MAGIC_NUMBER=20250226
SLIPPAGE=20
ORDER_EXPIRY_MINUTES=240
OPEN_TP_COUNT=3
OPEN_TRAIL_AFTER_TP=1

# ── Gestion du risque ────────────────────────────────────────
MAX_POSITIONS=6
MAX_SPREAD_POINTS=50

# ── Filtre News Forex Factory ────────────────────────────────
NEWS_FILTER_ENABLED=true
NEWS_WINDOWS=15,5,15

# ── Filtre Horaire (UTC) ──────────────────────────────────────
TIME_FILTER_ENABLED=false
TIME_BLOCKED_WINDOWS=13:00-15:00,16:30-17:30

# ── Supabase Dashboard ───────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
